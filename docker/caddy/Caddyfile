{
    order rate_limit before basicauth
}

www.wordnet.dk {
    redir https://wordnet.dk{uri}
}

wordnet.dk, localhost {
    redir / /dannet

    # OUTER rate limits based solely on the IP address; finer rate limiting
    # occurs WITHIN the web service itself. Entity pages are what crawlers
    # hammer, so they get a tight limit unless fetched as transit, i.e. by the
    # frontend app (a classroom shares one IP).
    @entity {
        path /dannet/data/* /dannet/external/*
        not header Accept *transit*
    }
    rate_limit @entity {remote.ip} 120r/m
    rate_limit {remote.ip} 2400r/m

    # The default content-type matcher does NOT include Transit, so entity
    # data payloads (~1 MB for the largest synsets) went uncompressed.
    encode gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/ld+json*
            header Content-Type application/transit+json*
            header Content-Type application/edn*
            header Content-Type application/sparql-results+json*
            header Content-Type application/javascript*
            header Content-Type application/xml*
            header Content-Type image/svg+xml*
        }
    }

    # MCP Registry HTTP verification
    handle /.well-known/mcp-registry-auth {
        respond "v=MCPv1; k=ed25519; p=VRttGAV7g424WtABMMHdpZrCuhDR/zQrS+Ni+CGiBKs="
    }

    # Route MCP requests to the MCP server
    handle /mcp* {
        reverse_proxy mcp:8000
    }

    # Everything else goes to the DanNet web service; SEO/backlink harvesters
    # (which ignore robots.txt) get a 403
    handle {
        @junkbots header_regexp User-Agent (?i)(AhrefsBot|BLEXBot|Barkrowler|DataForSeoBot|DotBot|MJ12bot|SERankingBacklinksBot|SemrushBot|SleepBot)
        respond @junkbots 403
        reverse_proxy dannet:3456
    }
}
