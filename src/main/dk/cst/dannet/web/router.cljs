(ns dk.cst.dannet.web.router
  "Turns route changes into rendered pages: the reitit routes, the navigation
  callback that fetches page data, and the Rum mounting it triggers."
  (:require [clojure.string :as str]
            [cognitect.transit :as transit]
            [goog.functions :as gfn]
            ["react-dom" :as react-dom]
            [rum.core :as rum]
            [reitit.frontend :as rf]
            [reitit.frontend.easy :as rfe :refer [href]]
            [reitit.frontend.history :as rfh]
            [taoensso.telemere :as t]
            [dk.cst.dannet.web.ui :as ui]
            [dk.cst.dannet.web.ui.error :as error :include-macros true]
            [dk.cst.dannet.web.ui.page :as page]
            [dk.cst.dannet.web.app :as app])
  (:import [goog Uri]))

;; The React root, once mounted; see mount-page! for the states it holds.
(defonce root (atom nil))

;; The page value on display, with its :path.
(defonce location
  (atom {}))

;; The page value embedded in the HTML, until the first navigation shows it.
(defonce embedded
  (atom nil))

(def app-element
  (js/document.getElementById "app"))

(defn- take-embedded-page!
  "Read and remove the page value that the server embedded in the HTML."
  []
  (when-let [elem (js/document.getElementById "page-data")]
    (.remove elem)
    (transit/read app/transit-reader (.-textContent elem))))

(def fallback
  "Catastrophic error fallback for when page-shell itself fails."
  (page/error {:languages ["en" nil "da"]}))

(defn- mount-page!
  "Mount page-component with error protection for catastrophic failures."
  [page-component]
  ;; Protects the React render phase. Errors during hiccup generation
  ;; (in the let binding before this call) are not caught, but those
  ;; are unlikely since it's just data manipulation.
  (error/try-static-render app-element
    (case @root
      nil
      (do
        ;; Set before hydrate so if it throws, @root reflects the failure.
        (reset! root :hydration-failed)
        (reset! root (rum/hydrate page-component app-element)))

      :hydration-failed
      (do
        (t/log! :warn "Hydration failed previously - mounting fresh React root")
        (reset! root (rum/mount page-component app-element)))

      ;; Rendered synchronously, so the new page is laid out before the scroll
      ;; position is restored.
      (react-dom/flushSync #(rum/mount page-component @root)))
    fallback))

;; All paths prefixed with /dannet/ are matched, content generated by the SPA.
;; Other routes bypass the frontend routing entirely, e.g. /download/...
;; Please refer to /doc/web.md to see how routing is meant to work.
(def routes
  [["/dannet" :delegate-root]
   ["/dannet/{*path}" :delegate-path]
   ["/framenet/{*path}" :delegate-framenet-path]])

;; The scroll position of the page content is kept in the state of each
;; history entry. New entries have none, so a new page starts at the top, while
;; going back or forward returns to where the page was left.
(defn- restore-scroll!
  "Scroll the page content to the position stored in the current history
  entry, or to the top when there is none."
  []
  (when-let [content (js/document.getElementById "content")]
    (.scroll content #js {:top (or (some-> js/window.history.state .-scroll) 0)})))

(def save-scroll-soon!
  (gfn/debounce app/save-scroll! 150))

;; Installed once: scrolling keeps the current history entry up to date.
(defonce scroll-listener
  (.addEventListener js/document "scroll"
                     #(when (= "content" (.. % -target -id))
                        (save-scroll-soon!))
                     #js {:capture true :passive true}))

(defn- ignore-anchor-click?
  "Decide whether reitit should handle a click on a link, as reitit does, but
  leave downloads to the browser. The scroll position is saved first, since
  reitit then adds a new history entry."
  [router e el uri]
  (when (and (rfh/ignore-anchor-click? router e el uri)
             ;; don't include downloads in client routing
             (not (re-find #"format=" (.getQuery uri))))
    (app/save-scroll!)
    true))

(defn- current?
  "Is `path` still the page that the user navigated to? Callbacks compare
  their path to it to detect that they have become stale."
  [path]
  (= path (:path @location)))

(defn merge-deferred-entity
  "Merge `deferred` entity data into `entity`, concatenating collections.
  Used by the client to combine truncated initial data with deferred remainder."
  [entity deferred]
  (merge-with (fn [old new]
                (if (and (coll? old) (coll? new))
                  (into old new)
                  new))
              entity
              deferred))

(defn- load-deferred!
  "Fetch the rest of the entity at `path`, which the server held back to load
  the page faster, and show the page again with it."
  [path query-params]
  (-> (app/fetch! path {:query-params (assoc query-params :deferred true)})
      (.then (fn [{:keys [body]}]
               (app/clear-current-fetch path)
               ;; Merging into a page that the user has left would clobber the
               ;; current page with data from the previous one.
               (if (current? path)
                 (when-let [deferred (:data body)]
                   ;; The deferred response also carries the labels of the
                   ;; overflow values, since the initial :entities map is
                   ;; trimmed to the displayed resources.
                   (let [page (update @location :data
                                      #(-> %
                                           (update :entity
                                                   merge-deferred-entity
                                                   (:entity deferred))
                                           (update :entities merge
                                                   (:entities deferred))))]
                     (reset! location page)
                     (mount-page! (ui/page-shell page))))
                 (t/log! {:level :warn
                          :data  {:expected-path path
                                  :current-path  (:path @location)}}
                         "Discarded stale deferred response"))))
      (.catch (fn [err]
                (t/log! {:level :warn
                         :error err
                         :data  {:path path}}
                        "Deferred fetch failed")))))

(defn- show-page!
  "Show the `page` value at `path`, or follow its redirect."
  [path query-params {:keys [redirect replace? title deferred?] :as page}]
  (if redirect
    ;; Further distinguish between internal and external redirects.
    (if (str/starts-with? redirect "/")
      (app/navigate-to redirect {:replace? replace?})
      (js/window.location.replace redirect))
    (do
      (set! js/document.title title)
      (reset! location (assoc page :path path))

      ;; Ensure that the search overlay closes when clicking 'back'.
      (js/document.activeElement.blur)

      (mount-page! (ui/page-shell page))
      (restore-scroll!)

      ;; Re-enable scroll-to-id (SPAs tend to break this feature). The id is
      ;; looked up directly, since ids such as what-is-sparql? are not valid
      ;; CSS selectors.
      (when-let [elem-with-id (some-> js/window.location.hash
                                      (subs 1)
                                      (not-empty)
                                      (js/decodeURIComponent)
                                      (js/document.getElementById))]
        (.scrollIntoView elem-with-id))

      ;; Large Synset entities have truncated semantic relations on
      ;; initial load. Fetch the remainder and re-render when ready.
      ;; TODO: this causes word clouds to re-render every time.
      ;;       Investigate whether we can skip re-mount.
      (when deferred?
        (load-deferred! path query-params)))))

(defn- show-error!
  "Show the error page in place of a page that failed to load."
  []
  (mount-page! (ui/page-shell {:page :error
                               :data {:languages (or (:languages @app/session)
                                                     ["en" nil "da"])}})))

(defn on-navigate
  "The core frontend function; gets called on every path change and shows the
  page at the new path. The first page is embedded in the HTML; every later
  page is fetched."
  [{:keys [path query-params] :as m}]
  ;; Abort in-flight fetches from previous pages to prevent race conditions
  ;; that cause queued pages to load unexpectedly in quick succession.
  (app/abort-stale-fetches)
  (swap! location assoc :path path)
  (if-let [page @embedded]
    (do
      (reset! embedded nil)
      (show-page! path query-params page))
    (-> (app/fetch! path {:query-params query-params})
        (.then (fn [{:keys [body]}]
                 (app/clear-current-fetch path)
                 (when (current? path)
                   (show-page! path query-params body))))
        (.catch (fn [err]
                  (when-not (= "AbortError" (some-> err .-name))
                    (app/clear-current-fetch path)
                    (t/log! {:level :error
                             :error err
                             :data  {:path path}}
                            "Page fetch failed")
                    (when (current? path)
                      (show-error!))))))))

(defn init!
  "Set up the Reitit router. This also starts the rendering loop by calling
  'on-navigate', which handles everything related to rendering a frontend page.

  The first page comes embedded in the HTML, and its preferences seed the
  session."
  []
  (set! (.-scrollRestoration js/window.history) "manual")
  (when-let [page (take-embedded-page!)]
    (swap! app/session merge (:prefs page))
    (reset! embedded page))
  (rfe/start! (rf/router routes)
              on-navigate
              {:use-fragment         false
               :ignore-anchor-click? ignore-anchor-click?}))

;; This function is only used by the shadow-cljs watch process!
(defn ^:dev/after-load render []
  (let [page-component (ui/page-shell @location)]
    ;; Call both again to ensure that we keep up-to-date with code changes
    (init!)
    (mount-page! page-component)))
