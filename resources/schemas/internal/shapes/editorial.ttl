# DanNet SHACL shapes: EDITORIAL rules for newly edited data.
#
# Stricter requirements than base.ttl, meant ONLY for targeted validation of
# individual focus nodes touched by an edit (see `validate-node` and
# `validate-changes`) before a write is committed. Legacy data is deliberately
# exempt: running these against the full graph would drown signal in noise.
#
# DRAFT editorial policy, grounded in a survey of the live data (2026-11-09,
# the 2026-10-02 release):
# every convention below holds for 100% of the surveyed data unless a comment
# says otherwise. Severities are policy knobs: sh:Violation blocks a write,
# sh:Warning only surfaces in the editing UI. The rough rule applied here is
# that universally clean conventions block while incomplete ones (missing
# definitions, hypernyms, ontological types) only warn.
#
# NOTE: property shapes get explicit IRIs; see the note in base.ttl.
#
# NOTE: a shape with sh:pattern for a value that can be edited has a
# sh:description in Danish and English, which says to an editor what a value
# has to be. The editor checks a typed text against the pattern in the
# browser, so a pattern has to mean the same in JavaScript as in SHACL.
#
# NOTE: each node shape of an entry names the base shape of its kind with
# sh:node, since an edited entry follows the base rules too. The editor reads
# the base rules through that link (see property-constraints in
# db/shapes.clj). validate-changes leaves out the result of the link itself
# (see link-result? there).

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix wn:      <https://globalwordnet.github.io/schemas/wn#> .
@prefix dns:     <https://wordnet.dk/dannet/schema/> .
@prefix marl:    <http://www.gsi.upm.es/ontologies/marl/ns#> .

## The SPARQL constraints here get their prefixes from this declaration;
## dns:DanNetPrefixes (base.ttl) is for the targets and constraints there.
dns:EditorialPrefixes
    sh:declare [ sh:prefix "rdf" ;
                 sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dnc" ;
                 sh:namespace "https://wordnet.dk/dannet/concepts/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dns" ;
                 sh:namespace "https://wordnet.dk/dannet/schema/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ontolex" ;
                 sh:namespace "http://www.w3.org/ns/lemon/ontolex#"^^xsd:anyURI ] .

dns:EditorialConceptShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalConcept ;
    sh:node dns:LexicalConceptShape ;
    sh:property dns:EditorialConceptShape-definition ,
                dns:EditorialConceptShape-label ,
                dns:EditorialConceptShape-lexicalizedSense ,
                dns:EditorialConceptShape-ontologicalType ,
                dns:EditorialConceptShape-ontologicalTypeValue ,
                dns:EditorialConceptShape-hypernym ,
                dns:EditorialConceptShape-lexfile ,
                dns:EditorialConceptShape-subject ,
                dns:EditorialConceptShape-hypernymValue,
                dns:EditorialConceptShape-agent,
                dns:EditorialConceptShape-also,
                dns:EditorialConceptShape-attribute,
                dns:EditorialConceptShape-co_agent_instrument,
                dns:EditorialConceptShape-co_instrument_agent,
                dns:EditorialConceptShape-domain_topic,
                dns:EditorialConceptShape-holo_location,
                dns:EditorialConceptShape-holo_member,
                dns:EditorialConceptShape-holo_part,
                dns:EditorialConceptShape-holo_substance,
                dns:EditorialConceptShape-instance_hypernym,
                dns:EditorialConceptShape-involved_patient,
                dns:EditorialConceptShape-mero_location,
                dns:EditorialConceptShape-mero_member,
                dns:EditorialConceptShape-mero_part,
                dns:EditorialConceptShape-mero_substance,
                dns:EditorialConceptShape-patient,
                dns:EditorialConceptShape-result,
                dns:EditorialConceptShape-similar,
                dns:EditorialConceptShape-crossPoSHypernym,
                dns:EditorialConceptShape-nearAntonym,
                dns:EditorialConceptShape-orthogonalHypernym,
                dns:EditorialConceptShape-usedFor,
                dns:EditorialConceptShape-usedForObject,
                dns:EditorialConceptShape-eq_synonym,
                dns:EditorialConceptShape-eqHypernym,
                dns:EditorialConceptShape-eqHyponym,
                dns:EditorialConceptShape-eqSimilar,
                dns:EditorialConceptShape-iliValue,
                dns:EditorialConceptShape-gender,
                dns:EditorialConceptShape-sentiment .

## DanNet definitions are asserted as skos:definition (60687 synsets, all
## @da); wn:definition does not occur in the dataset. 23 synsets carry two
## definitions and ~9.8k none, hence sh:Warning rather than a blocking rule.
dns:EditorialConceptShape-definition a sh:PropertyShape ;
    sh:path skos:definition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have exactly one Danish (@da) skos:definition." .

## All 70475 synset labels are a single @da literal of the form {...}.
dns:EditorialConceptShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^\\{[^{}]+\\}$" ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A synset label must be a single @da literal of the form {...}." .

## Only 3 legacy synsets lack a lexicalized sense; a new synset without one
## would be unreachable from the lexicon.
dns:EditorialConceptShape-lexicalizedSense a sh:PropertyShape ;
    sh:path ontolex:lexicalizedSense ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "An edited synset must be lexicalized by at least one sense." .

## 69730 of 70475 synsets carry a dns:ontologicalType; presence only warns
## since 745 legacy synsets lack one. The base shape of a synset says that
## it has at most one.
dns:EditorialConceptShape-ontologicalType a sh:PropertyShape ;
    sh:path dns:ontologicalType ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have a dns:ontologicalType." .

## When present, the value must be a named, typed dnt: ontological type
## (cf. ->ontotype in bootstrap/corsem.clj); member atoms are checked by
## dns:EditorialOntotypeShape below.
dns:EditorialConceptShape-ontologicalTypeValue a sh:PropertyShape ;
    sh:path dns:ontologicalType ;
    sh:nodeKind sh:IRI ;
    sh:class dns:OntologicalType ;
    sh:severity sh:Violation ;
    sh:message "dns:ontologicalType must reference a typed dns:OntologicalType resource." .

## 12069 of 70475 synsets legitimately lack a hypernym (top-level synsets;
## adjectives, which link laterally instead), so this can only ever warn.
dns:EditorialConceptShape-hypernym a sh:PropertyShape ;
    sh:path wn:hypernym ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have a wn:hypernym (roots and e.g. adjectives may legitimately lack one)." .

## A lexicographer file is a code such as "noun.animal": all 71054 are plain
## literals without a language (2026-11-12). Its 52 names all have a part of
## speech before the full stop (2026-11-19).
dns:EditorialConceptShape-lexfile a sh:PropertyShape ;
    sh:path wn:lexfile ;
    sh:datatype xsd:string ;
    sh:pattern "^(noun|verb|adj|adv)\\.[A-Za-z]+$" ;
    sh:description "Skal være noun, verb, adj eller adv, et punktum og et navn, f.eks. noun.animal"@da ,
                   "Must be noun, verb, adj or adv, a full stop and a name, e.g. noun.animal"@en ;
    sh:severity sh:Violation ;
    sh:message "wn:lexfile must be a plain literal such as noun.animal, without a language." .

## Subjects come in Danish and English: 37188 literals of each (2026-11-12).
dns:EditorialConceptShape-subject a sh:PropertyShape ;
    sh:path dc:subject ;
    sh:languageIn ( "da" "en" ) ;
    sh:severity sh:Violation ;
    sh:message "dc:subject must be a @da or @en literal." .

## Each relation of a synset that an editor can add has a shape that names
## the shape of its values. 25 relations link a DanNet synset to another: all
## 288274 of their values are typed synsets in dn:. Four link it to an English
## synset: all 10301 of their values are typed synsets of the Open English
## WordNet (2026-11-23).
##
## wn:hyponym (29 triples) and wn:holonym (10) are asserted too, but they
## are the inverses of relations above and have no shape.
dns:EditorialSynsetValueShape a sh:NodeShape ;
    sh:class ontolex:LexicalConcept ;
    sh:pattern "^https://wordnet\\.dk/dannet/data/" ;
    sh:description "Skal være et synset i DanNet, f.eks. dn:synset-3047"@da ,
                   "Must be a synset in DanNet, e.g. dn:synset-3047"@en .

dns:EditorialEnglishSynsetValueShape a sh:NodeShape ;
    sh:class ontolex:LexicalConcept ;
    sh:pattern "^https://en-word\\.net/id/" ;
    sh:description "Skal være et synset i Open English WordNet, f.eks. en:oewn-02086723-n"@da ,
                   "Must be a synset in the Open English WordNet, e.g. en:oewn-02086723-n"@en .

dns:EditorialConceptShape-hypernymValue a sh:PropertyShape ;
    sh:path wn:hypernym ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:hypernym must link to a synset in DanNet." .

dns:EditorialConceptShape-agent a sh:PropertyShape ;
    sh:path wn:agent ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:agent must link to a synset in DanNet." .

dns:EditorialConceptShape-also a sh:PropertyShape ;
    sh:path wn:also ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:also must link to a synset in DanNet." .

dns:EditorialConceptShape-attribute a sh:PropertyShape ;
    sh:path wn:attribute ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:attribute must link to a synset in DanNet." .

dns:EditorialConceptShape-co_agent_instrument a sh:PropertyShape ;
    sh:path wn:co_agent_instrument ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:co_agent_instrument must link to a synset in DanNet." .

dns:EditorialConceptShape-co_instrument_agent a sh:PropertyShape ;
    sh:path wn:co_instrument_agent ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:co_instrument_agent must link to a synset in DanNet." .

dns:EditorialConceptShape-domain_topic a sh:PropertyShape ;
    sh:path wn:domain_topic ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:domain_topic must link to a synset in DanNet." .

dns:EditorialConceptShape-holo_location a sh:PropertyShape ;
    sh:path wn:holo_location ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:holo_location must link to a synset in DanNet." .

dns:EditorialConceptShape-holo_member a sh:PropertyShape ;
    sh:path wn:holo_member ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:holo_member must link to a synset in DanNet." .

dns:EditorialConceptShape-holo_part a sh:PropertyShape ;
    sh:path wn:holo_part ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:holo_part must link to a synset in DanNet." .

dns:EditorialConceptShape-holo_substance a sh:PropertyShape ;
    sh:path wn:holo_substance ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:holo_substance must link to a synset in DanNet." .

dns:EditorialConceptShape-instance_hypernym a sh:PropertyShape ;
    sh:path wn:instance_hypernym ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:instance_hypernym must link to a synset in DanNet." .

dns:EditorialConceptShape-involved_patient a sh:PropertyShape ;
    sh:path wn:involved_patient ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:involved_patient must link to a synset in DanNet." .

dns:EditorialConceptShape-mero_location a sh:PropertyShape ;
    sh:path wn:mero_location ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:mero_location must link to a synset in DanNet." .

dns:EditorialConceptShape-mero_member a sh:PropertyShape ;
    sh:path wn:mero_member ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:mero_member must link to a synset in DanNet." .

dns:EditorialConceptShape-mero_part a sh:PropertyShape ;
    sh:path wn:mero_part ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:mero_part must link to a synset in DanNet." .

dns:EditorialConceptShape-mero_substance a sh:PropertyShape ;
    sh:path wn:mero_substance ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:mero_substance must link to a synset in DanNet." .

dns:EditorialConceptShape-patient a sh:PropertyShape ;
    sh:path wn:patient ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:patient must link to a synset in DanNet." .

dns:EditorialConceptShape-result a sh:PropertyShape ;
    sh:path wn:result ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:result must link to a synset in DanNet." .

dns:EditorialConceptShape-similar a sh:PropertyShape ;
    sh:path wn:similar ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:similar must link to a synset in DanNet." .

dns:EditorialConceptShape-crossPoSHypernym a sh:PropertyShape ;
    sh:path dns:crossPoSHypernym ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:crossPoSHypernym must link to a synset in DanNet." .

dns:EditorialConceptShape-nearAntonym a sh:PropertyShape ;
    sh:path dns:nearAntonym ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:nearAntonym must link to a synset in DanNet." .

dns:EditorialConceptShape-orthogonalHypernym a sh:PropertyShape ;
    sh:path dns:orthogonalHypernym ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:orthogonalHypernym must link to a synset in DanNet." .

dns:EditorialConceptShape-usedFor a sh:PropertyShape ;
    sh:path dns:usedFor ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:usedFor must link to a synset in DanNet." .

dns:EditorialConceptShape-usedForObject a sh:PropertyShape ;
    sh:path dns:usedForObject ;
    sh:node dns:EditorialSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:usedForObject must link to a synset in DanNet." .

dns:EditorialConceptShape-eq_synonym a sh:PropertyShape ;
    sh:path wn:eq_synonym ;
    sh:node dns:EditorialEnglishSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "wn:eq_synonym must link to a synset in the Open English WordNet." .

dns:EditorialConceptShape-eqHypernym a sh:PropertyShape ;
    sh:path dns:eqHypernym ;
    sh:node dns:EditorialEnglishSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:eqHypernym must link to a synset in the Open English WordNet." .

dns:EditorialConceptShape-eqHyponym a sh:PropertyShape ;
    sh:path dns:eqHyponym ;
    sh:node dns:EditorialEnglishSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:eqHyponym must link to a synset in the Open English WordNet." .

dns:EditorialConceptShape-eqSimilar a sh:PropertyShape ;
    sh:path dns:eqSimilar ;
    sh:node dns:EditorialEnglishSynsetValueShape ;
    sh:severity sh:Violation ;
    sh:message "dns:eqSimilar must link to a synset in the Open English WordNet." .

## All 8015 wn:ili values are IRIs of the Interlingual Index (2026-11-23).
dns:EditorialConceptShape-iliValue a sh:PropertyShape ;
    sh:path wn:ili ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://globalwordnet\\.org/ili/" ;
    sh:description "Skal være et ILI-begreb, f.eks. ili:i46360"@da ,
                   "Must be an ILI concept, e.g. ili:i46360"@en ;
    sh:severity sh:Violation ;
    sh:message "wn:ili must link to a concept of the Interlingual Index." .

## 623 synsets have a gender, never more than one: dns:Female (377) or
## dns:Male (246) (2026-11-23).
dns:EditorialConceptShape-gender a sh:PropertyShape ;
    sh:path dns:gender ;
    sh:maxCount 1 ;
    sh:in ( dns:Female dns:Male ) ;
    sh:severity sh:Violation ;
    sh:message "dns:gender must be dns:Female or dns:Male." .

## A sentiment is a blank node without a type, so its shape has no target of
## its own and the synset names it with sh:node. The 181 sentiments in dn:
## each have one polarity, marl:Negative (114) or marl:Positive (67). No
## synset has more than one sentiment, counting the 10792 synsets whose
## sentiment is in the DDS dataset, which also has neutral ones and a
## polarity value (2026-11-23).
dns:EditorialConceptShape-sentiment a sh:PropertyShape ;
    sh:path dns:sentiment ;
    sh:maxCount 1 ;
    sh:node dns:EditorialSentimentShape ;
    sh:severity sh:Violation ;
    sh:message "A synset has at most one dns:sentiment, with a single marl:hasPolarity." .

dns:EditorialSentimentShape a sh:NodeShape ;
    sh:property dns:EditorialSentimentShape-hasPolarity .

dns:EditorialSentimentShape-hasPolarity a sh:PropertyShape ;
    sh:path marl:hasPolarity ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( marl:Positive marl:Negative ) ;
    sh:severity sh:Violation ;
    sh:message "marl:hasPolarity must be marl:Positive or marl:Negative." .

## All 667 member atoms across the live dnt: bags are dnc: concepts; a newly
## minted ontotype must keep it that way.
dns:EditorialOntotypeShape a sh:NodeShape ;
    sh:targetClass dns:OntologicalType ;
    sh:severity sh:Violation ;
    sh:sparql dns:EditorialOntotypeShape-dncMembers .

dns:EditorialOntotypeShape-dncMembers a sh:SPARQLConstraint ;
    sh:prefixes dns:EditorialPrefixes ;
    sh:message "Every member (rdf:_N) of an ontological type must be a dnc: concept." ;
    sh:select """
SELECT $this ?value WHERE {
  $this ?p ?value .
  FILTER(strstarts(str(?p), concat(str(rdf:), "_")))
  FILTER(!strstarts(str(?value), str(dnc:)))
}""" .

dns:EditorialWordShape a sh:NodeShape ;
    sh:targetClass ontolex:Word , ontolex:MultiwordExpression , ontolex:Affix ;
    sh:node dns:LexicalEntryShape ;
    sh:property dns:EditorialWordShape-label ,
                dns:EditorialWordShape-partOfSpeech ,
                dns:EditorialWordShape-canonicalForm ,
                dns:EditorialWordShape-otherForm ;
    sh:sparql dns:EditorialWordShape-stressedMatchesWritten .

## All 62039 word labels are a single @da literal in ASCII double quotes.
dns:EditorialWordShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^\"[^\"]+\"$" ;
    sh:description "Skal være et ord i anførselstegn, f.eks. \"hund\""@da ,
                   "Must be a word in double quotes, e.g. \"hund\""@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A word label must be a single @da literal of the form \"...\"." .

## Current editorial policy admits three parts of speech (the survey found no
## others and never more than one per word); extend the list as policy does,
## e.g. with wn:adverb.
dns:EditorialWordShape-partOfSpeech a sh:PropertyShape ;
    sh:path wn:partOfSpeech ;
    sh:maxCount 1 ;
    sh:in ( wn:noun wn:verb wn:adjective ) ;
    sh:severity sh:Violation ;
    sh:message "wn:partOfSpeech must be one of wn:noun, wn:verb, or wn:adjective." .

## A form is a blank node without a type, so its shape has no target of its
## own and the word names it with sh:node. All 62039 canonical forms and all
## 140 other forms have one written form, which is a @da literal (2026-11-23).
dns:EditorialWordShape-canonicalForm a sh:PropertyShape ;
    sh:path ontolex:canonicalForm ;
    sh:node dns:EditorialFormShape ;
    sh:severity sh:Violation ;
    sh:message "A canonical form must have a single @da ontolex:writtenRep, and at most one dns:stressedRep." .

dns:EditorialWordShape-otherForm a sh:PropertyShape ;
    sh:path ontolex:otherForm ;
    sh:node dns:EditorialFormShape ;
    sh:severity sh:Violation ;
    sh:message "An other form must have a single @da ontolex:writtenRep, and at most one dns:stressedRep." .

dns:EditorialFormShape a sh:NodeShape ;
    sh:property dns:EditorialFormShape-writtenRep ,
                dns:EditorialFormShape-stressedRep .

dns:EditorialFormShape-writtenRep a sh:PropertyShape ;
    sh:path ontolex:writtenRep ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "ontolex:writtenRep must be a single @da literal." .

## All 76 stressed forms are a @da literal with one stress sign, and no form
## has more than one (2026-11-23).
dns:EditorialFormShape-stressedRep a sh:PropertyShape ;
    sh:path dns:stressedRep ;
    sh:maxCount 1 ;
    sh:pattern "^[^ˈ]*ˈ[^ˈ]+$" ;
    sh:description "Skal have ét tryktegn ˈ foran det betonede ord, f.eks. se ˈtil"@da ,
                   "Must have one stress sign ˈ before the stressed word, e.g. se ˈtil"@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "dns:stressedRep must be a single @da literal with one stress sign." .

## All 76 stressed forms are the written form of their node with the stress
## sign added. The rule is about two values of a form, so it is on the word.
dns:EditorialWordShape-stressedMatchesWritten a sh:SPARQLConstraint ;
    sh:prefixes dns:EditorialPrefixes ;
    sh:message "dns:stressedRep must be the ontolex:writtenRep of its form with a stress sign added." ;
    sh:select """
SELECT $this ?value WHERE {
  $this ontolex:canonicalForm|ontolex:otherForm ?form .
  ?form dns:stressedRep ?value ;
        ontolex:writtenRep ?written .
  FILTER(replace(str(?value), "ˈ", "") != str(?written))
}""" .

dns:EditorialSenseShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalSense ;
    sh:node dns:LexicalSenseShape ;
    sh:property dns:EditorialSenseShape-label ,
                dns:EditorialSenseShape-word ,
                dns:EditorialSenseShape-synset ,
                dns:EditorialSenseShape-dslSense ,
                dns:EditorialSenseShape-senseExample ,
                dns:EditorialSenseShape-usageNote ,
                dns:EditorialSenseShape-comment ,
                dns:EditorialSenseShape-altLabel ,
                dns:EditorialSenseShape-frequency ,
                dns:EditorialSenseShape-dating ,
                dns:EditorialSenseShape-register .

## All 77289 sense labels are a single unwrapped @da literal (no quotes or
## braces), typically lemma + DDO homograph/sense notation (e.g. cykel_§1).
## The notation itself is too varied for a stricter pattern.
dns:EditorialSenseShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^[^\"{][^\"{}]*$" ;
    sh:description "Skal være uden anførselstegn og klammer, f.eks. hund_1§1"@da ,
                   "Must be without quotes and braces, e.g. hund_1§1"@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A sense label must be a single unwrapped @da literal (no quotes or braces)." .

## A sense is the link between one word and one synset: each of the 77288
## senses is the ontolex:sense of exactly one word and the
## ontolex:lexicalizedSense of exactly one synset, and no other graph points
## to a dn: sense with either (2026-11-24).
dns:EditorialSenseShape-word a sh:PropertyShape ;
    sh:path [ sh:inversePath ontolex:sense ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "A sense must be the ontolex:sense of exactly one word." .

dns:EditorialSenseShape-synset a sh:PropertyShape ;
    sh:path [ sh:inversePath ontolex:lexicalizedSense ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "A sense must be the ontolex:lexicalizedSense of exactly one synset." .

## A DSL sense is an ID of digits such as "21054863": all 2347 are plain
## literals of that form (2026-11-19).
dns:EditorialSenseShape-dslSense a sh:PropertyShape ;
    sh:path dns:dslSense ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]+$" ;
    sh:description "Skal være et ID af cifre, f.eks. 21054863"@da ,
                   "Must be an ID of digits, e.g. 21054863"@en ;
    sh:severity sh:Violation ;
    sh:message "dns:dslSense must be a plain literal of digits, without a language." .

## All 63277 examples are @da literals (2026-11-12).
dns:EditorialSenseShape-senseExample a sh:PropertyShape ;
    sh:path lexinfo:senseExample ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:senseExample must be a @da literal." .

## All 2609 usage notes are @da literals (2026-11-12).
dns:EditorialSenseShape-usageNote a sh:PropertyShape ;
    sh:path lexinfo:usageNote ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:usageNote must be a @da literal." .

## Comments come in Danish and English: 49 literals of each (2026-11-12).
dns:EditorialSenseShape-comment a sh:PropertyShape ;
    sh:path rdfs:comment ;
    sh:languageIn ( "da" "en" ) ;
    sh:severity sh:Violation ;
    sh:message "rdfs:comment must be a @da or @en literal." .

## All 59 alternative labels are @da literals without quotes or braces, as
## the label of a sense is (2026-11-23).
dns:EditorialSenseShape-altLabel a sh:PropertyShape ;
    sh:path skos:altLabel ;
    sh:pattern "^[^\"{][^\"{}]*$" ;
    sh:description "Skal være uden anførselstegn og klammer, f.eks. hund_1§1"@da ,
                   "Must be without quotes and braces, e.g. hund_1§1"@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "skos:altLabel must be an unwrapped @da literal (no quotes or braces)." .

## The three marks below each have few values in use, and a sense never has
## more than one of each (2026-11-23). Extend a list as the policy does.
## All 1481 frequencies are lexinfo:rarelyUsed.
dns:EditorialSenseShape-frequency a sh:PropertyShape ;
    sh:path lexinfo:frequency ;
    sh:maxCount 1 ;
    sh:in ( lexinfo:rarelyUsed ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:frequency must be lexinfo:rarelyUsed." .

## All 433 datings are lexinfo:old.
dns:EditorialSenseShape-dating a sh:PropertyShape ;
    sh:path lexinfo:dating ;
    sh:maxCount 1 ;
    sh:in ( lexinfo:old ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:dating must be lexinfo:old." .

## The 261 registers are lexinfo:slangRegister (182) or
## lexinfo:inHouseRegister (79).
dns:EditorialSenseShape-register a sh:PropertyShape ;
    sh:path lexinfo:register ;
    sh:maxCount 1 ;
    sh:in ( lexinfo:slangRegister lexinfo:inHouseRegister ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:register must be lexinfo:slangRegister or lexinfo:inHouseRegister." .
