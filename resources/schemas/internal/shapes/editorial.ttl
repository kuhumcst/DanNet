# DanNet SHACL shapes: EDITORIAL rules for newly edited data.
#
# Stricter requirements than base.ttl, meant ONLY for targeted validation of
# individual focus nodes touched by an edit (see `validate-node` and
# `validate-changes`) before a write is committed. Legacy data is deliberately
# exempt: running these against the full graph would drown signal in noise.
#
# DRAFT editorial policy, grounded in a survey of the live data (2026-11-09,
# the 2026-10-02 release):
# every convention below holds for 100% of the surveyed data unless a comment
# says otherwise. Severities are policy knobs: sh:Violation blocks a write,
# sh:Warning only surfaces in the editing UI. The rough rule applied here is
# that universally clean conventions block while incomplete ones (missing
# definitions, hypernyms, ontological types) only warn.
#
# NOTE: property shapes get explicit IRIs; see the note in base.ttl.
#
# NOTE: a shape with sh:pattern for a value that can be edited has a
# sh:description in Danish and English, which says to an editor what a value
# has to be. The editor checks a typed text against the pattern in the
# browser, so a pattern has to mean the same in JavaScript as in SHACL.
#
# NOTE: each node shape of an entry names the base shape of its kind with
# sh:node, since an edited entry follows the base rules too. The editor reads
# the base rules through that link (see property-constraints in
# db/shapes.clj). validate-changes leaves out the result of the link itself
# (see link-result? there).

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix wn:      <https://globalwordnet.github.io/schemas/wn#> .
@prefix dns:     <https://wordnet.dk/dannet/schema/> .

## dns:DanNetPrefixes (base.ttl, always loaded alongside this file) declares
## dn/dns/ili/ontolex/wn; the constraints here additionally need rdf and dnc.
dns:EditorialPrefixes
    sh:declare [ sh:prefix "rdf" ;
                 sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dnc" ;
                 sh:namespace "https://wordnet.dk/dannet/concepts/"^^xsd:anyURI ] .

## ---------------------------------------------------------------------------
## LexicalConcept (synset)
## ---------------------------------------------------------------------------
dns:EditorialConceptShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalConcept ;
    sh:node dns:LexicalConceptShape ;
    sh:property dns:EditorialConceptShape-definition ,
                dns:EditorialConceptShape-label ,
                dns:EditorialConceptShape-lexicalizedSense ,
                dns:EditorialConceptShape-ontologicalType ,
                dns:EditorialConceptShape-ontologicalTypeValue ,
                dns:EditorialConceptShape-hypernym ,
                dns:EditorialConceptShape-lexfile ,
                dns:EditorialConceptShape-subject .

## DanNet definitions are asserted as skos:definition (60687 synsets, all
## @da); wn:definition does not occur in the dataset. 23 synsets carry two
## definitions and ~9.8k none, hence sh:Warning rather than a blocking rule.
dns:EditorialConceptShape-definition a sh:PropertyShape ;
    sh:path skos:definition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have exactly one Danish (@da) skos:definition." .

## All 70475 synset labels are a single @da literal of the form {...}.
dns:EditorialConceptShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^\\{[^{}]+\\}$" ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A synset label must be a single @da literal of the form {...}." .

## Only 3 legacy synsets lack a lexicalized sense; a new synset without one
## would be unreachable from the lexicon.
dns:EditorialConceptShape-lexicalizedSense a sh:PropertyShape ;
    sh:path ontolex:lexicalizedSense ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "An edited synset must be lexicalized by at least one sense." .

## 69730 of 70475 synsets carry exactly one dns:ontologicalType (never more);
## presence only warns since 745 legacy synsets lack one.
dns:EditorialConceptShape-ontologicalType a sh:PropertyShape ;
    sh:path dns:ontologicalType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have exactly one dns:ontologicalType." .

## When present, the value must be a named, typed dnt: ontological type
## (cf. ->ontotype in bootstrap/corsem.clj); member atoms are checked by
## dns:EditorialOntotypeShape below.
dns:EditorialConceptShape-ontologicalTypeValue a sh:PropertyShape ;
    sh:path dns:ontologicalType ;
    sh:nodeKind sh:IRI ;
    sh:class dns:OntologicalType ;
    sh:severity sh:Violation ;
    sh:message "dns:ontologicalType must reference a typed dns:OntologicalType resource." .

## 12069 of 70475 synsets legitimately lack a hypernym (top-level synsets;
## adjectives, which link laterally instead), so this can only ever warn.
dns:EditorialConceptShape-hypernym a sh:PropertyShape ;
    sh:path wn:hypernym ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "An edited synset should have a wn:hypernym (roots and e.g. adjectives may legitimately lack one)." .

## A lexicographer file is a code such as "noun.animal": all 71054 are plain
## literals without a language (2026-11-12). Its 52 names all have a part of
## speech before the full stop (2026-11-19).
dns:EditorialConceptShape-lexfile a sh:PropertyShape ;
    sh:path wn:lexfile ;
    sh:datatype xsd:string ;
    sh:pattern "^(noun|verb|adj|adv)\\.[A-Za-z]+$" ;
    sh:description "Skal være noun, verb, adj eller adv, et punktum og et navn, f.eks. noun.animal"@da ,
                   "Must be noun, verb, adj or adv, a full stop and a name, e.g. noun.animal"@en ;
    sh:severity sh:Violation ;
    sh:message "wn:lexfile must be a plain literal such as noun.animal, without a language." .

## Subjects come in Danish and English: 37188 literals of each (2026-11-12).
dns:EditorialConceptShape-subject a sh:PropertyShape ;
    sh:path dc:subject ;
    sh:languageIn ( "da" "en" ) ;
    sh:severity sh:Violation ;
    sh:message "dc:subject must be a @da or @en literal." .

## All 58741 asserted hypernym edges resolve within dn:; an edit must not
## introduce a dangling one. Same existence rule as dns:LinkedSynsetShape.
dns:EditorialHypernymTargetShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalConcept ;
    sh:severity sh:Violation ;
    sh:sparql dns:EditorialHypernymTargetShape-resolvableTarget .

dns:EditorialHypernymTargetShape-resolvableTarget a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "wn:hypernym must target a known synset (typed as a lexical concept or carrying a lexicalized sense)." ;
    sh:select """
SELECT $this ?value WHERE {
  $this wn:hypernym ?value .
  FILTER NOT EXISTS { ?value a ontolex:LexicalConcept }
  FILTER NOT EXISTS { ?value ontolex:lexicalizedSense ?sense }
}""" .

## All 7680 asserted wn:eq_synonym links target a typed synset (local build,
## 2026-11-10, with the dangling OEWN links replaced); an edit must not
## introduce a dangling one.
dns:EditorialEqSynonymTargetShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalConcept ;
    sh:severity sh:Violation ;
    sh:sparql dns:EditorialEqSynonymTargetShape-resolvableTarget .

dns:EditorialEqSynonymTargetShape-resolvableTarget a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "wn:eq_synonym must target a known synset (typed as a lexical concept)." ;
    sh:select """
SELECT $this ?value WHERE {
  $this wn:eq_synonym ?value .
  FILTER NOT EXISTS { ?value a ontolex:LexicalConcept }
}""" .

## ---------------------------------------------------------------------------
## OntologicalType (dnt:): all 667 member atoms across the live dnt: bags are
## dnc: concepts; a newly minted ontotype must keep it that way.
## ---------------------------------------------------------------------------
dns:EditorialOntotypeShape a sh:NodeShape ;
    sh:targetClass dns:OntologicalType ;
    sh:severity sh:Violation ;
    sh:sparql dns:EditorialOntotypeShape-dncMembers .

dns:EditorialOntotypeShape-dncMembers a sh:SPARQLConstraint ;
    sh:prefixes dns:EditorialPrefixes ;
    sh:message "Every member (rdf:_N) of an ontological type must be a dnc: concept." ;
    sh:select """
SELECT $this ?value WHERE {
  $this ?p ?value .
  FILTER(strstarts(str(?p), concat(str(rdf:), "_")))
  FILTER(!strstarts(str(?value), str(dnc:)))
}""" .

## ---------------------------------------------------------------------------
## Word / MultiwordExpression
## ---------------------------------------------------------------------------
dns:EditorialWordShape a sh:NodeShape ;
    sh:targetClass ontolex:Word , ontolex:MultiwordExpression ;
    sh:node dns:LexicalEntryShape ;
    sh:property dns:EditorialWordShape-label ,
                dns:EditorialWordShape-partOfSpeech ,
                dns:EditorialWordShape-canonicalForm .

## All 61994 word labels are a single @da literal in ASCII double quotes.
dns:EditorialWordShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^\"[^\"]+\"$" ;
    sh:description "Skal være et ord i anførselstegn, f.eks. \"hund\""@da ,
                   "Must be a word in double quotes, e.g. \"hund\""@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A word label must be a single @da literal of the form \"...\"." .

## Current editorial policy admits three parts of speech (the survey found no
## others and never more than one per word); extend the list as policy does,
## e.g. with wn:adverb.
dns:EditorialWordShape-partOfSpeech a sh:PropertyShape ;
    sh:path wn:partOfSpeech ;
    sh:maxCount 1 ;
    sh:in ( wn:noun wn:verb wn:adjective ) ;
    sh:severity sh:Violation ;
    sh:message "wn:partOfSpeech must be one of wn:noun, wn:verb, or wn:adjective." .

## A form is a blank node without a type, so its shape has no target of its
## own and the word names it with sh:node. All 62039 canonical forms have one
## written form, which is a @da literal (2026-11-19).
dns:EditorialWordShape-canonicalForm a sh:PropertyShape ;
    sh:path ontolex:canonicalForm ;
    sh:node dns:EditorialFormShape ;
    sh:severity sh:Violation ;
    sh:message "A canonical form must have a single @da ontolex:writtenRep." .

dns:EditorialFormShape a sh:NodeShape ;
    sh:property dns:EditorialFormShape-writtenRep .

dns:EditorialFormShape-writtenRep a sh:PropertyShape ;
    sh:path ontolex:writtenRep ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "ontolex:writtenRep must be a single @da literal." .

## ---------------------------------------------------------------------------
## LexicalSense
## ---------------------------------------------------------------------------
dns:EditorialSenseShape a sh:NodeShape ;
    sh:targetClass ontolex:LexicalSense ;
    sh:node dns:LexicalSenseShape ;
    sh:property dns:EditorialSenseShape-label ,
                dns:EditorialSenseShape-dslSense ,
                dns:EditorialSenseShape-senseExample ,
                dns:EditorialSenseShape-usageNote ,
                dns:EditorialSenseShape-comment .

## All 77289 sense labels are a single unwrapped @da literal (no quotes or
## braces), typically lemma + DDO homograph/sense notation (e.g. cykel_§1).
## The notation itself is too varied for a stricter pattern.
dns:EditorialSenseShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:maxCount 1 ;
    sh:pattern "^[^\"{][^\"{}]*$" ;
    sh:description "Skal være uden anførselstegn og klammer, f.eks. hund_1§1"@da ,
                   "Must be without quotes and braces, e.g. hund_1§1"@en ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "A sense label must be a single unwrapped @da literal (no quotes or braces)." .

## A DSL sense is an ID of digits such as "21054863": all 2347 are plain
## literals of that form (2026-11-19).
dns:EditorialSenseShape-dslSense a sh:PropertyShape ;
    sh:path dns:dslSense ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]+$" ;
    sh:description "Skal være et ID af cifre, f.eks. 21054863"@da ,
                   "Must be an ID of digits, e.g. 21054863"@en ;
    sh:severity sh:Violation ;
    sh:message "dns:dslSense must be a plain literal of digits, without a language." .

## All 63277 examples are @da literals (2026-11-12).
dns:EditorialSenseShape-senseExample a sh:PropertyShape ;
    sh:path lexinfo:senseExample ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:senseExample must be a @da literal." .

## All 2609 usage notes are @da literals (2026-11-12).
dns:EditorialSenseShape-usageNote a sh:PropertyShape ;
    sh:path lexinfo:usageNote ;
    sh:languageIn ( "da" ) ;
    sh:severity sh:Violation ;
    sh:message "lexinfo:usageNote must be a @da literal." .

## Comments come in Danish and English: 49 literals of each (2026-11-12).
dns:EditorialSenseShape-comment a sh:PropertyShape ;
    sh:path rdfs:comment ;
    sh:languageIn ( "da" "en" ) ;
    sh:severity sh:Violation ;
    sh:message "rdfs:comment must be a @da or @en literal." .
