# DanNet SHACL shapes — BASE (asserted) graph invariants.
#
# A small, deliberately conservative starter set of structural invariants,
# chosen by validating against the live data. Accepted violation counts are
# recorded in shapes-baseline.edn; counts exceeding them indicate regressions.
#
# SCOPE — dn: resources only:
#   DanNet only controls the dn: dataset, so shapes use SPARQL-based targets
#   (SHACL-AF) scoped to the dn: namespace rather than sh:targetClass. This
#   deliberately excludes companion datasets (COR, OEWN) that follow their own
#   conventions. Note that dn: words are typed ontolex:Word or
#   ontolex:MultiwordExpression -- never ontolex:LexicalEntry directly -- and
#   the asserted graph contains no ontolex subClassOf triples, so an
#   sh:targetClass would miss them entirely.
#
# IMPORTANT — base vs. inferred graph:
#   Validate these against the BASE (asserted) model. Relation-completeness
#   checks (e.g. "every sense links to a synset") do NOT belong here: in DanNet
#   the sense→synset link is asserted in only one direction (Danish senses carry
#   only the inverse `ontolex:lexicalizedSense` on the synset), and the forward
#   `ontolex:isLexicalizedSenseOf` is supplied by inference. Such a shape run
#   against the base graph produces ~77k false positives. Relation-shape checks
#   live in inferred.ttl instead; stricter rules that only gate *newly edited*
#   data live in editorial.ttl.
#
# NOTE: property shapes are deliberately given explicit IRIs (rather than the
# usual blank nodes) so that validation reports can group violations by a
# stable shape identity -- used e.g. for the violation baseline check.
#
# NOTE: wn:definition is intentionally NOT required on synsets here; that rule
# lives in editorial.ttl, gating newly edited data only.

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix wn:      <https://globalwordnet.github.io/schemas/wn#> .
@prefix dns:     <https://wordnet.dk/dannet/schema/> .

## ---------------------------------------------------------------------------
## SPARQL-based targets scoped to the dn: namespace.
## NB: SHACL-AF SPARQL queries do not inherit the Turtle prefixes above; they
## get their prefixes from the sh:declare block below (via sh:prefixes).
## ---------------------------------------------------------------------------
dns:DanNetPrefixes
    sh:declare [ sh:prefix "dn" ;
                 sh:namespace "https://wordnet.dk/dannet/data/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dns" ;
                 sh:namespace "https://wordnet.dk/dannet/schema/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ili" ;
                 sh:namespace "http://globalwordnet.org/ili/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "ontolex" ;
                 sh:namespace "http://www.w3.org/ns/lemon/ontolex#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "wn" ;
                 sh:namespace "https://globalwordnet.github.io/schemas/wn#"^^xsd:anyURI ] .

dns:DanNetEntryTarget a sh:SPARQLTarget ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:select """
SELECT ?this WHERE {
  VALUES ?type { ontolex:LexicalEntry ontolex:Word ontolex:MultiwordExpression }
  ?this a ?type .
  FILTER(strstarts(str(?this), str(dn:)))
}""" .

dns:DanNetSenseTarget a sh:SPARQLTarget ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:select """
SELECT ?this WHERE {
  ?this a ontolex:LexicalSense .
  FILTER(strstarts(str(?this), str(dn:)))
}""" .

dns:DanNetConceptTarget a sh:SPARQLTarget ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:select """
SELECT ?this WHERE {
  ?this a ontolex:LexicalConcept .
  FILTER(strstarts(str(?this), str(dn:)))
}""" .

## ---------------------------------------------------------------------------
## LexicalEntry (dn: words & multiword expressions)
## ---------------------------------------------------------------------------
dns:LexicalEntryShape a sh:NodeShape ;
    sh:target dns:DanNetEntryTarget ;
    sh:property dns:LexicalEntryShape-label ,
                dns:LexicalEntryShape-partOfSpeech ,
                dns:LexicalEntryShape-sense ,
                dns:LexicalEntryShape-canonicalForm ,
                dns:LexicalEntryShape-writtenRep ,
                dns:LexicalEntryShape-inScheme .

dns:LexicalEntryShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalEntry must have an rdfs:label." .

dns:LexicalEntryShape-partOfSpeech a sh:PropertyShape ;
    sh:path wn:partOfSpeech ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalEntry must have a wn:partOfSpeech." .

dns:LexicalEntryShape-sense a sh:PropertyShape ;
    sh:path ontolex:sense ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalEntry must have at least one ontolex:sense." .

dns:LexicalEntryShape-canonicalForm a sh:PropertyShape ;
    sh:path ontolex:canonicalForm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:severity sh:Violation ;
    sh:message "LexicalEntry must have exactly one ontolex:canonicalForm." .

## The sequence path also covers dangling canonicalForm blank nodes (GitHub
## issue #203): the shape above only checks that the canonicalForm triple
## exists, not that its object carries a written representation.
dns:LexicalEntryShape-writtenRep a sh:PropertyShape ;
    sh:path ( ontolex:canonicalForm ontolex:writtenRep ) ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalEntry must have an ontolex:writtenRep reachable via ontolex:canonicalForm." .

## skos:inScheme (GitHub issue #175) is added to every dn: resource during
## bootstrapping (see add-in-scheme! in the bootstrap ns); a missing value
## only warns since scheme membership is metadata, not lexical structure.
dns:LexicalEntryShape-inScheme a sh:PropertyShape ;
    sh:path skos:inScheme ;
    sh:hasValue <https://wordnet.dk/dannet/data> ;
    sh:severity sh:Warning ;
    sh:message "LexicalEntry should have skos:inScheme <https://wordnet.dk/dannet/data>." .

## ---------------------------------------------------------------------------
## LexicalSense (dn:)
## ---------------------------------------------------------------------------
dns:LexicalSenseShape a sh:NodeShape ;
    sh:target dns:DanNetSenseTarget ;
    sh:property dns:LexicalSenseShape-label ,
                dns:LexicalSenseShape-inScheme .

dns:LexicalSenseShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalSense must have an rdfs:label." .

dns:LexicalSenseShape-inScheme a sh:PropertyShape ;
    sh:path skos:inScheme ;
    sh:hasValue <https://wordnet.dk/dannet/data> ;
    sh:severity sh:Warning ;
    sh:message "LexicalSense should have skos:inScheme <https://wordnet.dk/dannet/data>." .

## ---------------------------------------------------------------------------
## LexicalConcept (dn: synsets)
## ---------------------------------------------------------------------------
dns:LexicalConceptShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:property dns:LexicalConceptShape-label ,
                dns:LexicalConceptShape-inScheme .

dns:LexicalConceptShape-label a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "LexicalConcept (synset) must have an rdfs:label." .

dns:LexicalConceptShape-inScheme a sh:PropertyShape ;
    sh:path skos:inScheme ;
    sh:hasValue <https://wordnet.dk/dannet/data> ;
    sh:severity sh:Warning ;
    sh:message "LexicalConcept (synset) should have skos:inScheme <https://wordnet.dk/dannet/data>." .

## ---------------------------------------------------------------------------
## Hypernym hierarchy (dn: synsets) — SPARQL-based semantic checks.
## wn:hypernym is ASSERTED in the base graph (152k+ triples), so these belong
## here rather than in inferred.ttl. Severity is a property of the node shape,
## hence two shapes: hierarchy errors block, POS disagreement only warns.
## ---------------------------------------------------------------------------
dns:HypernymHierarchyShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:severity sh:Violation ;
    sh:sparql dns:HypernymHierarchyShape-selfHypernymy ,
              dns:HypernymHierarchyShape-mutualHypernymy .

dns:HypernymHierarchyShape-selfHypernymy a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "A synset must not be its own hypernym." ;
    sh:select """
SELECT $this WHERE {
  $this wn:hypernym $this .
}""" .

dns:HypernymHierarchyShape-mutualHypernymy a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "Two synsets must not be hypernyms of each other." ;
    sh:select """
SELECT $this ?value WHERE {
  $this wn:hypernym ?value .
  ?value wn:hypernym $this .
  FILTER(?value != $this)
}""" .

## Cross-POS hypernymy is only a warning: the live data deliberately links
## e.g. verbal nouns to verb synsets ({sammenskrivning} -> {skrive}), so this
## surfaces for curation without ever blocking a write or an export.
## The path below only uses ASSERTED triples: the synset carries
## ontolex:lexicalizedSense and the word carries ontolex:sense + partOfSpeech
## (the inverse directions are inference-only; see the note at the top).
dns:HypernymPOSShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:severity sh:Warning ;
    sh:sparql dns:HypernymPOSShape-posAgreement .

dns:HypernymPOSShape-posAgreement a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "Synset and its hypernym are lexicalized by words with different parts of speech." ;
    sh:select """
SELECT DISTINCT $this ?value WHERE {
  $this wn:hypernym ?value .
  FILTER(strstarts(str(?value), str(dn:)))
  $this ontolex:lexicalizedSense ?sense1 .
  ?word1 ontolex:sense ?sense1 ; wn:partOfSpeech ?pos1 .
  ?value ontolex:lexicalizedSense ?sense2 .
  ?word2 ontolex:sense ?sense2 ; wn:partOfSpeech ?pos2 .
  FILTER(?pos1 != ?pos2)
}""" .

## ---------------------------------------------------------------------------
## Meronymy (dn: synsets) — SPARQL-based semantic checks.
## Both mero_* and holo_* directions are asserted independently in the base
## graph, which allows two classes of directionality error (all instances
## found in the live data are recorded in shapes-baseline.edn):
##   1. the same relation asserted both ways (X mero_part Y, Y mero_part X)
##   2. a mero_* and a holo_* edge between the same pair in the same
##      direction (X mero_substance Y, X holo_part Y) -- contradictory
##      regardless of subtype, since it makes X and Y parts of each other.
## Split into two node shapes so the baseline can track them separately.
## ---------------------------------------------------------------------------
dns:MeronymyHierarchyShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:severity sh:Violation ;
    sh:sparql dns:MeronymyHierarchyShape-selfMeronymy ,
              dns:MeronymyHierarchyShape-mutualMeronymy .

dns:MeronymyHierarchyShape-selfMeronymy a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "A synset must not be a meronym or holonym of itself." ;
    sh:select """
SELECT $this WHERE {
  VALUES ?p { wn:mero_part wn:mero_member wn:mero_substance wn:mero_location
              wn:holo_part wn:holo_member wn:holo_substance wn:holo_location
              wn:meronym wn:holonym }
  $this ?p $this .
}""" .

dns:MeronymyHierarchyShape-mutualMeronymy a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "The same part-whole relation must not be asserted in both directions between two synsets." ;
    sh:select """
SELECT $this ?value WHERE {
  VALUES ?p { wn:mero_part wn:mero_member wn:mero_substance wn:mero_location
              wn:holo_part wn:holo_member wn:holo_substance wn:holo_location
              wn:meronym wn:holonym }
  $this ?p ?value .
  ?value ?p $this .
  FILTER(?value != $this)
}""" .

dns:MeronymyContradictionShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:severity sh:Violation ;
    sh:sparql dns:MeronymyContradictionShape-meroHoloContradiction .

dns:MeronymyContradictionShape-meroHoloContradiction a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "A synset must not have both a mero_* and a holo_* relation to the same synset; one of the two directions must be wrong." ;
    sh:select """
SELECT DISTINCT $this ?value WHERE {
  VALUES ?m { wn:mero_part wn:mero_member wn:mero_substance wn:mero_location wn:meronym }
  VALUES ?h { wn:holo_part wn:holo_member wn:holo_substance wn:holo_location wn:holonym }
  $this ?m ?value .
  $this ?h ?value .
}""" .

## ---------------------------------------------------------------------------
## Interlingual Index links (GitHub issue #205): eq* relations hold between
## synsets in separate datasets, so only wn:ili may link a synset to an ILI
## entry. The constraint names the three eq* relations rather than flagging
## "any predicate but wn:ili" so that it stays valid against the INFERRED
## model too, where each eq* triple also surfaces as its skos:*Match
## superproperty.
## ---------------------------------------------------------------------------
dns:IliRelationShape a sh:NodeShape ;
    sh:target dns:DanNetConceptTarget ;
    sh:severity sh:Violation ;
    sh:sparql dns:IliRelationShape-eqTargetsIli .

dns:IliRelationShape-eqTargetsIli a sh:SPARQLConstraint ;
    sh:prefixes dns:DanNetPrefixes ;
    sh:message "An eq* relation must target a synset, not an Interlingual Index entry; only wn:ili may link to the ILI." ;
    sh:select """
SELECT $this ?value WHERE {
  VALUES ?rel { dns:eqHypernym dns:eqHyponym dns:eqSimilar }
  $this ?rel ?value .
  FILTER(strstarts(str(?value), str(ili:)))
}""" .
