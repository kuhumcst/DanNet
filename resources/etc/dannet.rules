#------------------------------------------------------------------
# DanNet inference rules for Jena's GenericRuleReasoner (HYBRID mode).
#
# This is a purpose-built replacement for the hacked-down copy of
# Jena's OWL micro/FB rule set previously found in this file.
# DanNet's schemas only exercise two kinds of OWL/RDFS inference:
#
#   1. owl:inverseOf      - nearly every wn:/dns: synset relation
#      declares an inverse; symmetric relations (e.g. wn:antonym,
#      dns:nearAntonym) are modeled as self-inverses.
#   2. rdfs:subPropertyOf - SKOS mappings declared on wn:/dns:
#      properties, e.g. wn:hypernym -> skos:broader and
#      dns:eqHypernym -> skos:broadMatch.
#
# Both are implemented as forward rules generating *tabled backward*
# rules per property (pair), so the derived triples are computed on
# demand at query time rather than being materialized in the store.
#
# Deliberately omitted (inferring nothing or too costly for our data):
#   - equality reasoning (owl:sameAs, Functional/InverseFunctional)
#   - OWL restrictions, cardinality, disjointness, validation rules
#   - domain/range type entailment (rdfs2/rdfs3); all rdf:type
#     assertions in DanNet are explicit
#   - transitive property closure; use SPARQL property paths instead,
#     e.g. `wn:hypernym+` or `skos:broader+`
#------------------------------------------------------------------

@prefix wn:      <https://globalwordnet.github.io/schemas/wn#>.
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>.

#------------------------------------------------------------------
# Tabling directives
#------------------------------------------------------------------

-> table(rdf:type).
-> table(rdfs:subClassOf).
-> table(rdfs:range).
-> table(rdfs:domain).

#------------------------------------------------------------------
# owl:inverseOf
#------------------------------------------------------------------

# Anonymous inverses are skipped: the PreMOn ontologies declare
# owl:inverseOf on blank nodes inside restrictions, and materializing
# those would put blank-node predicates on every frame element.
[inverseOf1: (?P owl:inverseOf ?Q), notBNode(?P), notBNode(?Q)
             -> (?Q owl:inverseOf ?P) ]

[inverseOf2: (?P owl:inverseOf ?Q), notBNode(?P), notBNode(?Q)
             -> table(?P), table(?Q),
             [inverseOf2b: (?X ?P ?Y) <- (?Y ?Q ?X)] ]

# Propagate domain/range declarations across inverse pairs.
[inverseOf5: (?P owl:inverseOf ?Q), (?P rdfs:range ?C) -> (?Q rdfs:domain ?C) ]
[inverseOf6: (?P owl:inverseOf ?Q), (?P rdfs:domain ?C) -> (?Q rdfs:range ?C) ]

#------------------------------------------------------------------
# rdfs:subPropertyOf
#------------------------------------------------------------------

# Transitivity of subPropertyOf itself (rdfs5); cheap on schema-sized data.
[rdfs5: (?P rdfs:subPropertyOf ?Q), (?Q rdfs:subPropertyOf ?R), notEqual(?P, ?R)
        -> (?P rdfs:subPropertyOf ?R) ]

# Property assertions entail assertions of their superproperties (rdfs6),
# e.g. (?A wn:hypernym ?B) entails (?A skos:broader ?B).
# wn:partOfSpeech is excluded: its superproperty entailment would copy the
# wn: VALUE unchanged (sameAs reasoning is omitted, see the header), so it
# is handled by the value-translating rules below instead.
# The owl top properties are excluded: PreMOn declares e.g.
# pmo:abbreviation as a subproperty of owl:topDataProperty, and the
# entailment is pure noise on entity pages.
[rdfs6: (?P rdfs:subPropertyOf ?Q), notEqual(?P, ?Q), notEqual(?P, wn:partOfSpeech),
        notBNode(?Q),
        notEqual(?Q, owl:topDataProperty), notEqual(?Q, owl:topObjectProperty)
        -> table(?P), table(?Q),
        [rdfs6b: (?A ?Q ?B) <- (?A ?P ?B)] ]

#------------------------------------------------------------------
# wn:partOfSpeech -> lexinfo:partOfSpeech (GitHub issue #17)
#
# Only the wn: PoS triple is asserted in the data; the lexinfo:
# equivalent is derived here, translating the value along the
# owl:sameAs pairs declared in the GWA schema; one rule per pair.
# wn:adjective_satellite, wn:named_entity, wn:other_pos and
# wn:unknown_pos have no lexinfo equivalent and derive nothing.
#------------------------------------------------------------------

-> table(lexinfo:partOfSpeech).

[posNoun:        (?W lexinfo:partOfSpeech lexinfo:noun)        <- (?W wn:partOfSpeech wn:noun) ]
[posVerb:        (?W lexinfo:partOfSpeech lexinfo:verb)        <- (?W wn:partOfSpeech wn:verb) ]
[posAdjective:   (?W lexinfo:partOfSpeech lexinfo:adjective)   <- (?W wn:partOfSpeech wn:adjective) ]
[posAdverb:      (?W lexinfo:partOfSpeech lexinfo:adverb)      <- (?W wn:partOfSpeech wn:adverb) ]
[posConjunction: (?W lexinfo:partOfSpeech lexinfo:conjunction) <- (?W wn:partOfSpeech wn:conjunction) ]
[posAdposition:  (?W lexinfo:partOfSpeech lexinfo:adposition)  <- (?W wn:partOfSpeech wn:adposition) ]
