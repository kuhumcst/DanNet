    "groups": [
      {
        "title": {
          "da": "taksonomi",
          "en": "taxonomy"
        },
        "description": {
          "da": "Over- og underbegreber: hyperonymi og hyponymi i DanNets forskellige varianter.",
          "en": "Broader and narrower concepts: hypernymy and hyponymy in DanNet's different variants."
        },
        "types": [
          "hypernym",
          "instance_hypernym",
          "orthogonalHypernym",
          "crossPoSHypernym"
        ]
      },
      {
        "title": {
          "da": "del og helhed",
          "en": "part and whole"
        },
        "description": {
          "da": "Meronymi og holonymi: relationer mellem dele og de helheder de indgår i.",
          "en": "Meronymy and holonymy: relations between parts and the wholes they belong to."
        },
        "types": [
          "meronym",
          "mero_part",
          "mero_member",
          "mero_substance",
          "mero_location"
        ]
      },
      {
        "title": {
          "da": "lighed og modsætning",
          "en": "similarity and opposition"
        },
        "description": {
          "da": "Begreber der ligger tæt på hinanden i betydning, eller som står i modsætning til hinanden.",
          "en": "Concepts that are close to each other in meaning, or that stand in opposition to each other."
        },
        "types": [
          "similar",
          "nearAntonym"
        ]
      },
      {
        "title": {
          "da": "roller og funktion",
          "en": "roles and function"
        },
        "description": {
          "da": "Deltagerroller og funktion: hvem der udfører handlingen, hvad den er rettet mod, hvad der kommer ud af den, og hvad noget bruges til.",
          "en": "Participant roles and function: who performs the action, what it is directed at, what comes out of it, and what something is used for."
        },
        "types": [
          "agent",
          "patient",
          "result",
          "co_instrument_agent",
          "usedFor",
          "usedForObject"
        ]
      },
      {
        "title": {
          "da": "emneområde",
          "en": "subject area"
        },
        "description": {
          "da": "Relationer der knytter begreber til det emneområde de hører hjemme i.",
          "en": "Relations that tie concepts to the subject area they belong to."
        },
        "types": [
          "domain_topic"
        ]
      },
      {
        "title": {
          "da": "systematisk polysemi",
          "en": "systematic polysemy"
        },
        "description": {
          "da": "Begreber der dækker hver sin læsning i et systematisk polysemimønster for samme ord, fx plante og fødevare.",
          "en": "Concepts that cover the two readings of a systematic polysemy pattern for the same word, e.g. plant and foodstuff."
        },
        "types": [
          "alternatesTo",
          "alternatesWith"
        ]
      },
      {
        "title": {
          "da": "andet",
          "en": "other"
        },
        "description": {
          "da": "Øvrige relationer, fx løse krydshenvisninger.",
          "en": "Remaining relations, e.g. loose cross-references."
        }
      }
    ]
  },
